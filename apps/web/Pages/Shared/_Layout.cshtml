@{
    var page = (ViewData["ActivePage"] as string) ?? "";
    string Active(string key) => page == key ? "active" : "";
    bool scopeActive = page is "scope" or "requirements" or "features";
    bool buildActive = page is "cost" or "project" or "operations" or "steps";
    bool buyActive = page is "spec" or "purchase" or "buyoperations";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Build vs Buy Agent</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-page="@(page)">
<div class="site-header">
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand-link" href="/">
                <span class="logo">⛅</span>
                <span class="brand-text">
                    <strong>Build vs Buy Agent</strong>
                    <small class="tagline">Foundry agents · documents → scope → requirements → cost → Excel</small>
                </span>
            </a>
            <nav class="mainnav" aria-label="Primary">
                <a class="navlink @Active("upload")" href="/"><span class="nav-icon">📤</span> Upload</a>
                <a class="navlink @(scopeActive ? "active" : "")" href="/platform/scope"><span class="nav-icon">🔎</span> Scope</a>
                <a class="navlink @(buildActive ? "active" : "")" href="/platform/cost"><span class="nav-icon">🤖</span> Build</a>
                <a class="navlink @(buyActive ? "active" : "")" href="/platform/spec"><span class="nav-icon">🛒</span> Buy</a>
                <a class="navlink @Active("compare")" href="/compare"><span class="nav-icon">⚖️</span> Compare</a>
                <a class="navlink @Active("estimations")" href="/estimations"><span class="nav-icon">📊</span> Histories</a>
            </nav>
        </div>
    </header>

    @if (scopeActive)
    {
        <nav class="subnav" aria-label="Workflow">
            <div class="subnav-inner">
                <span class="subnav-label">Scope</span>
                <a class="sublink @Active("scope")" href="/platform/scope"><em>1</em> Background</a>
                <a class="sublink @Active("requirements")" href="/platform/requirements"><em>2</em> Requirements</a>
                <a class="sublink @Active("features")" href="/platform/features"><em>3</em> Features</a>
            </div>
        </nav>
    }
    else if (buyActive)
    {
        <nav class="subnav" aria-label="Workflow">
            <div class="subnav-inner">
                <span class="subnav-label">Buy</span>
                <a class="sublink @Active("spec")" href="/platform/spec"><em>1</em> Spec</a>
                <a class="sublink @Active("purchase")" href="/platform/purchase"><em>2</em> Purchase</a>
                <a class="sublink @Active("buyoperations")" href="/platform/buy-operations"><em>3</em> Operation Cost</a>
            </div>
        </nav>
    }
    else if (buildActive)
    {
        <nav class="subnav" aria-label="Workflow">
            <div class="subnav-inner">
                <span class="subnav-label">Build</span>
                <a class="sublink @Active("cost")" href="/platform/cost"><em>1</em> Cost Model</a>
                <a class="sublink @Active("project")" href="/platform/project"><em>2</em> Project Cost</a>
                <a class="sublink @Active("operations")" href="/platform/operations"><em>3</em> Operation Cost</a>
                <a class="sublink sublink-aux @Active("steps")" href="/platform/steps">Prompts</a>
            </div>
        </nav>
    }
</div>

<main>
    @RenderBody()
</main>

<!-- Shared modal host (sample viewer + agent-instruction popups) -->
<div id="modalRoot" class="modal-root" hidden>
    <div class="modal-backdrop" data-close="1"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="modal-head">
            <h3 id="modalTitle">Title</h3>
            <button type="button" class="modal-close" data-close="1" aria-label="Close">✕</button>
        </div>
        <div class="modal-body" id="modalBody"></div>
    </div>
</div>

<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
