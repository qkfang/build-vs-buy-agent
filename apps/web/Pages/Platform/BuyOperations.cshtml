@page "/platform/buy-operations"
@model Proj37.CostEstimator.Web.Pages.Platform.BuyOperationsModel
@{
    ViewData["Title"] = "Operation Cost";
    ViewData["ActivePage"] = "buyoperations";
}

<section class="card platform-head">
    <div class="result-head">
        <div>
            <h2>Operation Cost (Buy)</h2>
            <p class="hint" id="ctxLine">No estimation loaded yet.</p>
            <p class="hint" id="stepStatus"></p>
        </div>
        <div class="result-actions">
            <button type="button" class="btn btn-primary" id="runBuyOperationsBtn" hidden>▶ Run agent</button>
            <button type="button" class="btn btn-secondary" data-agent-step="buyoperations">ℹ Agent instructions</button>
            <a id="downloadBtn" class="btn btn-download" href="#" hidden>⬇ Download Excel</a>
        </div>
    </div>
</section>

<section class="card" id="emptyState">
    <p class="muted">No estimation has been run yet. <a href="/">Upload a document or run an example brief</a> to populate Build vs Buy Agent.</p>
</section>

<section class="card" id="buyOperationsCard" hidden>
    <div id="stepError" class="status error" hidden></div>
    <p class="hint">Ongoing monthly cost to run, support, and administer the purchased (Buy) solution, extracted from the uploaded Buy documents plus the Scope step. The <strong>Qty</strong> and <strong>Unit price</strong> columns are editable — change a value to recalculate the monthly run total live.</p>
    <div class="totals" id="buyOperationsTotals"></div>
    <div id="tab-buyoperations"></div>
</section>
